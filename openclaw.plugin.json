{
  "id": "pdfapihub",
  "name": "pdfapihub",
  "displayName": "PDF Toolkit",
  "description": "The complete PDF toolkit — generate, convert, merge, split, compress, lock, unlock, watermark, sign, OCR, parse, scan, and manage files. 30+ tools. Powered by PDFAPIHub.",
  "version": "1.0.1",
  "author": "PdfApiHub",
  "homepage": "https://pdfapihub.com",
  "extensions": ["./index.ts"],
  "skills": ["./skills"],
  "contracts": {
    "tools": [
      "compare_documents",
      "compress_image",
      "compress_pdf",
      "create_template",
      "delete_file",
      "delete_template",
      "document_to_pdf",
      "generate_chart",
      "generate_image",
      "generate_pdf",
      "get_template",
      "image_to_pdf",
      "list_files",
      "list_templates",
      "lock_pdf",
      "merge_pdfs",
      "ocr_image",
      "ocr_pdf",
      "parse_pdf",
      "pdf_info",
      "pdf_to_csv",
      "pdf_to_docx",
      "pdf_to_html",
      "pdf_to_image",
      "pdf_to_pptx",
      "pdf_to_text",
      "pdf_to_xlsx",
      "scan_enhance",
      "sign_pdf",
      "split_pdf",
      "unlock_pdf",
      "update_template",
      "upload_file",
      "url_to_html",
      "watermark_pdf"
    ]
  },
  "compat": { "pluginApi": ">=2026.3.24-beta.2", "minGatewayVersion": "2026.3.24-beta.2" },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "PDFAPIHub API key (required). Get a free key at https://pdfapihub.com. This key authenticates requests to pdfapihub.com/api. Files you process are sent to PDFAPIHub's servers."
      }
    }
  },
  "metadata": {
    "openclaw": {
      "primaryEnv": "PDFAPIHUB_API_KEY",
      "requires": {
        "env": ["PDFAPIHUB_API_KEY"]
      }
    }
  }
}
